---
const { item } = Astro.props;
---

<details class="faq-item">
  <summary>
    <span>{item.question}</span>
    <span class="faq-icon"></span>
  </summary>

  <p>{item.answer}</p>
</details>

<style>
  @layer components {
    .faq-item {
      border-bottom: 1px solid #dedede;
    }

    .faq-item summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem 0;
      cursor: pointer;
      list-style: none;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-icon::before {
      content: "+";
      font-size: 1.25rem;
      font-weight: 400;
    }

    .faq-item[open] .faq-icon::before {
      content: "−";
    }

    .faq-item p {
      margin: 0;
      padding: 0 3rem 1rem 0;
      font-size: 0.7rem;
      line-height: 1.5;
      color: var(--color-text-muted);
      white-space: pre-line;
    }
  }
</style>
