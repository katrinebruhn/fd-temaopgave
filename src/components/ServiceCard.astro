---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>
  <!-- <a> burde måske være en variant af en component -->
</article>

<style>
  @layer components {
    article {
      background: var(--color-surface-elevated-transparent);
      color: var(--color-on-surface-elevated);

      padding: 2rem;
      border-radius: 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.15);

      min-height: 11.5rem;
      box-sizing: border-box;

      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    article a {
      margin-top: 1rem;
    }

    h2 {
      font-size: 0.9rem;
      font-weight: 700;
    }

    p {
      font-size: 1.125rem;
      font-weight: 400;
      line-height: 1.5;
    }

    a {
      display: inline-flex;
      align-items: center;
      gap: 1ch;

      color: var(--color-action);
      font-size: 0.75rem;
      font-weight: bold;
    }

    a svg {
      inline-size: 14px;
    }
  }
</style>
