---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>
  <!-- <a> burde måske være en variant af en component -->
</article>

<style>
  @layer components {
    article {
      background: var(--color-surface-elevated-transparent);
      color: var(--color-on-surface-elevated);
      padding: 1rem;
      border-radius: 0.75rem;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 0.5rem;
    }
    h2 {
      font-size: 0.9rem;
      font-weight: 700;
    }

    p {
      font-size: 0.75rem;
      line-height: 1.4;
    }

    a {
      display: inline-flex;
      align-items: center;
      gap: 1ch;

      color: var(--color-action);
      font-size: 0.75rem;
      font-weight: bold;
    }

    a svg {
      inline-size: 14px;
    }
  }
</style>
