---
//@ts-nocheck
import ServiceCard from "@components/ServiceCard.astro";

const serviceData = await fetch("https://ftk-api.pages.dev/services").then(
  (res) => res.json(),
);
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  @layer components {
    .services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;

      max-width: 48rem;
      width: calc(100% - 4rem);
      margin-inline: auto;
      margin-top: 0;
      transform: translateY(-4.5rem);
      position: relative;
      z-index: 2;
    }
  }
</style>
