---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import WhatToExpect from "./WhatToExpect.astro";
import FinancialProjections from "./FinancialProjections.astro";
import ExperienceStats from "./ExperienceStats.astro";
import CoreValues from "./CoreValues.astro";
import ContactSection from "./ContactSection.astro";
import NewsletterFooter from "./NewsletterFooter.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>

    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>

    <div class="hero-actions">
      <a href="#0" class="button button-primary">Book a Meeting</a>
      <a href="#0" class="button button-secondary">Learn More</a>
    </div>
  </div>

  <div class="hero-image">
    <Image src={CEOImage} alt="CEO" />
    <div class="ombre-gradient"></div>
  </div>
</section>

<section class="services-section">
  <Services />
</section>

<WhatToExpect />
<FinancialProjections />
<ExperienceStats />
<CoreValues />
<ContactSection />
<NewsletterFooter />

<style>
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;

      height: 30rem;

      background: var(--color-surface-elevated);
      color: var(--color-on-surface-elevated);
    }

    .hero-content {
      padding: 4rem 6rem 5rem;
      max-width: 36rem;
      height: 100%;
      box-sizing: border-box;
    }

    .hero-content h1 {
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1.05;
      max-width: 10ch;
    }

    .hero-content p {
      max-width: 32rem;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-weight: 700;
      border-radius: 999px;
      padding: 0.75rem 1.25rem;
    }

    .button-primary {
      background: var(--color-action);
      color: var(--color-text);
    }

    .button-secondary {
      background: var(--color-on-surface-elevated);
      color: var(--color-text);
    }

    .hero-image {
      position: relative;
      height: 100%;
      overflow: hidden;
    }

    .hero-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ombre-gradient {
      position: absolute;
      inset: 0;

      background: linear-gradient(
        to right,
        var(--color-surface-elevated) 0%,
        transparent 35%
      );

      pointer-events: none;
    }

    .services-section {
      background: var(--color-surface-primary);
      padding-bottom: 10rem;
    }
  }
</style>
