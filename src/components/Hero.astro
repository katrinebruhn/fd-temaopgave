---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <a href="#0">Book a Meeting</a>
    <a href="#0">Learn More</a>
  </div>
  <Image src={CEOImage} alt="CEO" />

  <Services />
</section>

<style>
  /* Styles her */
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;

      background: var(--color-surface-elevated);
      color: var(--color-on-surface-elevated);
    }
    .hero-content {
      padding: 3rem;
      max-width: 36rem;
    }
    /*sikre at billedet fylder sin halvdel mere kontrolleret*/
    .hero > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
