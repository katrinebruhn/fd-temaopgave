---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import WhatToExpect from "./WhatToExpect.astro";
import FinancialProjections from "./FinancialProjections.astro";
import ExperienceStats from "./ExperienceStats.astro";
import CoreValues from "./CoreValues.astro";
import ContactSection from "./ContactSection.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-content">
    <h1>
      <span class="hero-first-line">
        <span class="line-em">Em</span><span class="no-line">p</span><span
          class="line-owerin">owerin</span
        ><span class="no-line">g</span><span class="word-your">&nbsp;Your</span>
      </span>

      <span class="hero-second-line">Business Growth</span>
    </h1>

    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>

    <div class="hero-actions">
      <a href="#0" class="button button-primary">Book a Meeting</a>
      <a href="#0" class="button button-secondary">Learn More</a>
    </div>
  </div>

  <div class="hero-image">
    <Image src={CEOImage} alt="CEO" />
    <div class="ombre-gradient"></div>
  </div>
</section>

<section class="services-section">
  <Services />
</section>

<WhatToExpect />
<FinancialProjections />
<ExperienceStats />
<CoreValues />
<ContactSection />

<style>
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      height: 30rem;
      background: var(--color-neutrals-900);
      color: var(--color-on-surface-elevated);
    }

    .hero-content {
      padding: 4rem 6rem 5rem;
      max-width: 36rem;
      height: 100%;
      box-sizing: border-box;
    }

    .hero-content h1 {
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1.05;
      margin: 0;
    }

    .hero-first-line,
    .hero-second-line {
      display: block;
      width: max-content;
    }

    .hero-first-line {
      white-space: nowrap;
    }

    .hero-first-line,
    .hero-second-line {
      display: block;
      width: max-content;
    }

    .hero-first-line {
      white-space: nowrap;
    }

    .line-em,
    .line-owerin {
      position: relative;
      display: inline-block;
    }

    /* Streg under "Em" */
    .line-em::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.08em;

      height: 0.18rem; /* tykkere */
      background: var(--color-action);
    }

    /* Fade-linje til venstre */
    .line-em::before {
      content: "";
      position: absolute;
      right: 100%;
      bottom: 0.08em;

      width: 18rem;
      height: 0.2rem;

      background: linear-gradient(
        to right,
        rgba(255, 204, 74, 0.05) 0%,
        rgba(255, 204, 74, 0.15) 35%,
        rgba(255, 204, 74, 0.45) 70%,
        rgba(255, 204, 74, 1) 100%
      );
    }

    /* Streg efter p'et og frem til før g'et */
    .line-owerin::after {
      content: "";
      position: absolute;

      left: -0.12em; /* rykker stregen tættere på p */
      right: 0;
      bottom: 0.08em;

      height: 0.2rem; /* tykkere */
      background: var(--color-action);
    }

    .no-line,
    .word-your {
      display: inline-block;
    }

    .hero-content p {
      max-width: 32rem;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-weight: 700;
      border-radius: 999px;
      padding: 0.75rem 1.25rem;
    }

    .button-primary {
      background: var(--color-action);
      color: var(--color-text);
    }

    .button-secondary {
      background: var(--color-on-surface-elevated);
      color: var(--color-text);
    }

    .hero-image {
      position: relative;
      height: 100%;
      overflow: hidden;
    }

    .hero-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ombre-gradient {
      background: linear-gradient(
        to right,
        var(--color-neutrals-900) 0%,
        transparent 35%
      );
    }

    .services-section {
      background: var(--color-surface-primary);
    }
  }
</style>
