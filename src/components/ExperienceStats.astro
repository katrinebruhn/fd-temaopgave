<section class="experience-section">
  <div class="experience-text">
    <p class="eyebrow">EXPERIENCE</p>
    <h2>More than 25 years of experience</h2>
    <p>3000+ our clients are insured around the World</p>
  </div>

  <div class="stat-list">
    <figure data-value="85">
      <svg viewBox="0 0 100 100">
        <circle class="track"></circle>
        <circle class="progress" pathLength="100"></circle>
        <circle class="marker" r="4"></circle>
      </svg>

      <span class="stat-value">0%</span>
      <figcaption>Consistency</figcaption>
    </figure>

    <figure data-value="95">
      <svg viewBox="0 0 100 100">
        <circle class="track"></circle>
        <circle class="progress" pathLength="100"></circle>
        <circle class="marker" r="4"></circle>
      </svg>

      <span class="stat-value">0%</span>
      <figcaption>Improvement</figcaption>
    </figure>

    <figure data-value="90">
      <svg viewBox="0 0 100 100">
        <circle class="track"></circle>
        <circle class="progress" pathLength="100"></circle>
        <circle class="marker" r="4"></circle>
      </svg>

      <span class="stat-value">0%</span>
      <figcaption>Branching</figcaption>
    </figure>
  </div>
</section>

<style>
  @layer components {
    .experience-section {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 4rem;

      padding: 5rem 6rem;
      background: var(--color-action);
      color: var(--color-text);
    }

    .experience-text {
      max-width: 18rem;
    }

    .experience-text h2 {
      font-size: 2rem;
      line-height: 1.1;
      margin-bottom: 1rem;
    }

    .stat-list {
      display: flex;
      gap: 3rem;
    }

    figure {
      flex: 0 0 9rem;
      min-width: 0;
      text-align: center;

      --current-value: 0;

      display: grid;
      grid-template-areas:
        "stack"
        "caption";

      container: stat / inline-size;
    }

    .stat-value {
      grid-area: stack;
      place-self: center;
      font-size: 2rem;
      font-weight: 700;
    }

    svg {
      grid-area: stack;
      transform: rotate(-90deg);
    }

    .track,
    .progress {
      cx: 50;
      cy: 50;
      r: 46;
      fill: none;
      stroke-width: 2.5;
    }

    .track {
      stroke: rgba(0, 0, 0, 0.2);
    }

    .progress {
      stroke: white;
      stroke-linecap: round;
      stroke-dasharray: 100;
      stroke-dashoffset: calc(100 - var(--current-value));
    }

    .marker {
      visibility: visible;
      fill: var(--color-surface-elevated);
      stroke: white;
      stroke-width: 2;

      offset-path: circle(46px at 50px 50px);
      offset-distance: calc(var(--current-value) * 1%);
    }

    figcaption {
      grid-area: caption;
      margin-top: 0.75rem;
      font-weight: 600;
    }
  }
</style>

<script>
  const section = document.querySelector(".experience-section");

  if (section) {
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];

        if (!entry.isIntersecting) return;

        const figures = section.querySelectorAll("figure");

        figures.forEach((figure) => {
          const target = Number(figure.getAttribute("data-value"));
          const value = figure.querySelector(".stat-value");

          let current = 0;
          const duration = 1200;
          const start = performance.now();

          function animate(time: number) {
            const progress = Math.min((time - start) / duration, 1);
            current = Math.round(target * progress);

            figure.style.setProperty("--current-value", String(current));

            if (value) {
              value.textContent = `${current}%`;
            }

            if (progress < 1) {
              requestAnimationFrame(animate);
            }
          }

          requestAnimationFrame(animate);
        });

        observer.disconnect();
      },
      {
        threshold: 0.25,
      },
    );

    observer.observe(section);
  }
</script>
