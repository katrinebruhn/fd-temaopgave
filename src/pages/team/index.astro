---
import Layout from "@layouts/Layout.astro";
import { getTeamMembers } from "@lib/api";
import TeamMember from "@components/TeamMember.astro";

const team = await getTeamMembers();

console.log(team);
---

<Layout>
  <section class="team-hero">
    <p class="team-label">TEAM</p>

    <h1>
      <span class="team-title-highlight">The Consultors</span>
    </h1>

    <p class="team-description">
      Our success stems from the synergy between dedicated teams and our valued
      clients. We prioritize a company culture that fosters exceptional
      productivity, ensures customer satisfaction.
    </p>
  </section>
  <section class="team-section">
    <div class="team-intro">
      <div>
        <h2>Meet Our Great Team</h2>

        <p>
          Welcome to our amazing team! We are a group of passionate individuals
          dedicated to excellence and innovation. Each member brings unique
          skills and experiences, working together to achieve our goals. Join us
          as we embark on exciting projects and create lasting impacts.
        </p>
      </div>

      <a href="#team-members" class="team-button">Join our team</a>
    </div>
    <div class="team-members" id="team-members">
      {team.map((employee: any) => <TeamMember employee={employee} />)}
    </div>
  </section>
</Layout>

<style>
  @layer components {
    .team-hero {
      text-align: center;
      padding: 4rem 2rem 5rem;
      background-color: var(--color-surface-secondary);
    }

    .team-label {
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      margin: 0 0 0.75rem;
    }

    .team-hero h1 {
      display: inline-block;
      position: relative;
      font-size: 2.5rem;
      margin: 0;
    }

    .team-title-highlight {
      position: relative;
      display: inline-block;
    }

    .team-title-highlight::before {
      content: "";
      position: absolute;

      right: 100%;
      bottom: 0.08em;

      width: 40rem;
      height: 0.2rem;

      background: var(--color-action);
    }

    .team-title-highlight::after {
      content: "";
      position: absolute;

      left: 0;
      right: 0;
      bottom: 0.08em;

      height: 0.2rem;
      background: var(--color-action);
    }

    .team-description {
      max-width: 32rem;
      margin: 2rem auto 0;
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
      color: var(--color-text-muted);
    }
    .team-section {
      background-color: var(--color-surface-primary);
      padding: 4rem 2rem;
    }

    .team-intro {
      max-width: 56rem;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 3rem;
    }

    .team-intro > div {
      max-width: 34rem;
    }

    .team-intro h2 {
      font-size: 1.5rem;
      font-weight: bold;
      margin: 0 0 0.75rem;
      color: var(--color-text);
    }

    .team-intro p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .team-button {
      background-color: var(--color-ui-primary);
      color: var(--color-on-ui-primary);
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      border-radius: 2rem;
      font-size: 0.7rem;
      white-space: nowrap;
    }
    .team-members {
      max-width: 56rem;
      margin: 2rem auto 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem 1.5rem;
    }
    @media (max-width: 700px) {
      .team-hero {
        padding: 3rem 1.5rem;
      }

      .team-hero h1 {
        font-size: 2rem;
      }

      .team-section {
        padding: 3rem 1.5rem;
      }

      .team-intro {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
      }

      .team-intro > div {
        max-width: 100%;
      }

      .team-members {
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-top: 4rem;
      }

      /* Medarbejderne venstrestilles på mobil */
      .team-members :global(.team-member) {
        align-items: flex-start;
        text-align: left;
      }

      .team-members :global(.team-member-image) {
        width: 60%;
      }
      .team-members :global(.team-member-description) {
        max-width: 22rem;
      }
      .team-members :global(.team-member-content) {
        width: 100%;
        text-align: left;
      }

      .team-members :global(.social-links) {
        justify-content: flex-start;
      }
    }
  }
</style>
