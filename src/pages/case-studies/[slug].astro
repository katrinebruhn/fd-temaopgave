---
// @ts-nocheck

/* Importerer data, billedkomponent og sidens layout */
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";

/* Opretter en dynamisk side for hvert case study ud fra slug */
export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

/* Henter data for det aktuelle case study */
const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
  <!-- Hero med titel og introduktion til det valgte case study -->
  <section class="case-hero">
    <p class="case-label">CASE STUDIES</p>

    <h1>
      <span class="case-title-highlight">{caseName}</span>
    </h1>

    <p class="case-description">
      Our achievements reflect the close collaboration between our expert teams
      and our esteemed clientele. We cultivate a workplace that champions peak
      performance and guarantees client satisfaction.
    </p>
  </section>

  <!-- Indhold for det aktuelle case study -->
  <article class="case-story-article">
    <!-- Case-billede og information -->
    <header>
      <Image
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />

      <div class="case-details">
        <dl>
          <div>
            <dt>Case Name</dt>
            <dd>{caseName}</dd>
          </div>

          <div>
            <dt>Category</dt>
            <dd class="category">{category}</dd>
          </div>

          <div>
            <dt>Date</dt>
            <dd class="date">{date}</dd>
          </div>
        </dl>

        <a href="#0" class="button">{buttonLabel}</a>
      </div>
    </header>

    <!-- Case-indhold genereret ud fra data -->
    <section class="case-story-content">
      {
        caseStudy.sections.map((section, index) => (
          <>
            {index === 0 ? <h2>{section.title}</h2> : <h3>{section.title}</h3>}

            {Array.isArray(section.content) ? (
              <>
                {section.content.map((item) => (
                  <p>{item}</p>
                ))}
              </>
            ) : (
              <p>{section.content}</p>
            )}

            {section.highlights && (
              <ul>
                {section.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}

            {section.image && (
              <figure>
                <Image
                  src={section.image.src}
                  alt={section.image.alt}
                  width={section.image.width}
                  height={section.image.height}
                />

                {section.image.caption && (
                  <figcaption>{section.image.caption}</figcaption>
                )}
              </figure>
            )}
          </>
        ))
      }
    </section>
  </article>
</Layout>

<style>
  @layer components {
    /* Hero */
    .case-hero {
      text-align: center;
      padding: 4rem 2rem 5rem;
      background-color: var(--color-surface-secondary);
    }

    .case-label {
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      margin: 0 0 0.75rem;
    }

    .case-hero h1 {
      font-size: 2.5rem;
      margin: 0;
    }

    .case-description {
      max-width: 32rem;
      margin: 2rem auto 0;
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
      color: var(--color-text-muted);
    }

    /* Case article */
    .case-story-article {
      max-width: 56rem;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    .case-story-article > header {
      position: relative;
      margin-bottom: 4rem;
    }

    .case-story-article > header > img {
      width: 100%;
      height: 22rem;
      object-fit: cover;
      display: block;
      border-radius: 0.75rem;
    }

    /* Information om case study */
    .case-details {
      position: relative;
      width: 85%;
      margin: -4rem auto 0;
      background-color: var(--color-neutrals-900);
      color: var(--color-on-surface-elevated);
      border-radius: 0.75rem;
      padding: 1.5rem 2rem;

      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .case-details dl {
      display: flex;
      gap: 3rem;
      margin: 0;
    }

    .case-details dt {
      font-size: 0.6rem;
      margin-bottom: 0.4rem;
    }

    .case-details dd {
      margin: 0;
      font-size: 0.65rem;
    }

    .case-details .button {
      background-color: var(--color-action);
      color: var(--color-text);
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      border-radius: 2rem;
      font-size: 0.65rem;
      font-weight: 600;
    }

    /* Tekstindhold i case study */
    .case-story-content {
      max-width: 48rem;
      margin: 0 auto;
    }

    .case-story-content > h2,
    .case-story-content > h3,
    .case-story-content > p,
    .case-story-content > ul {
      max-width: 38rem;
      margin-left: auto;
      margin-right: auto;
    }

    .case-story-content h2 {
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.2;
      margin-top: 3rem;
      margin-bottom: 1rem;
    }

    .case-story-content h3 {
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.2;
      margin-top: 3rem;
      margin-bottom: 1rem;
    }

    .case-story-content p {
      font-size: 0.8rem;
      line-height: 1.5;
      color: var(--color-text-muted);
      margin-top: 0;
      margin-bottom: 1.25rem;
    }

    .case-story-content ul {
      padding-left: 1rem;
      font-size: 0.8rem;
      line-height: 1.8;
      color: var(--color-text-muted);
    }

    /* Billeder i case study */
    .case-story-content figure {
      position: relative;
      margin: 2rem 0 0;
    }

    .case-story-content figure img {
      width: 100%;
      height: 20rem;
      object-fit: cover;
      display: block;
    }

    /* Sort gradient nederst på billedet */
    .case-story-content figure::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 20%;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        var(--color-neutrals-900) 100%
      );
      pointer-events: none;
    }

    /* Billedtekst oven på gradienten */
    .case-story-content figcaption {
      position: absolute;
      bottom: 0.75rem;
      left: 0;
      width: 100%;
      padding: 0 1.5rem;
      margin: 0;
      color: var(--color-on-surface-elevated);
      font-size: 0.6rem;
      text-align: center;
      z-index: 1;
    }

    .case-title-highlight {
      position: relative;
      display: inline-block;
      isolation: isolate;
    }

    .case-title-highlight::before {
      content: "";
      position: absolute;

      right: 100%;
      bottom: 0.08em;

      width: 40rem;
      height: 0.2rem;

      background: var(--color-action);
      z-index: -1;
    }

    .case-title-highlight::after {
      content: "";
      position: absolute;

      left: 0;
      right: 0;
      bottom: 0.08em;

      height: 0.2rem;

      background: var(--color-action);
      z-index: -1;
    }

    /* Mobil */
    @media (max-width: 700px) {
      .case-hero {
        padding: 3rem 1.5rem;
      }

      .case-hero h1 {
        font-size: 2rem;
      }

      .case-story-article {
        padding: 2rem 1.5rem;
      }

      .case-story-article > header > img {
        height: auto;
      }

      .case-details {
        width: 90%;
        margin: -2rem auto 0;
        padding: 1.5rem;
        flex-direction: column;
        align-items: stretch;
        gap: 1.5rem;
      }

      .case-details dl {
        flex-direction: column;
        gap: 1rem;
      }

      .case-details .button {
        text-align: center;
      }

      .case-story-content > h2,
      .case-story-content > h3,
      .case-story-content > p,
      .case-story-content > ul {
        max-width: 100%;
      }

      .case-story-content figure img {
        height: auto;
      }
    }
  }
</style>
